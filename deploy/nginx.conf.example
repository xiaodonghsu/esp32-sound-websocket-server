# 将 web/ 目录中的文件复制到 /var/www/esp32-sound-websocket-server/ 后，
# 把下面两个 location 放入 192.168.4.244 对应的 server 块。

location ^~ /esp32-sound-websocket-server/api/ {
    proxy_pass http://127.0.0.1:8060/;
    proxy_http_version 1.1;
    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_connect_timeout 5s;
    proxy_read_timeout 70s;
}

location ^~ /esp32-sound-websocket-server/ {
    root /var/www;
    index index.html;
    try_files $uri $uri/ /esp32-sound-websocket-server/index.html;
}
